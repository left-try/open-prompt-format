{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Prompt Format 0.1 frontmatter",
  "description": "JSON Schema for the parsed YAML mapping at the start of an OPF prompt file.",
  "type": "object",
  "required": ["format", "id", "version"],
  "properties": {
    "format": { "const": "opf/0.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
    },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "const": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced metadata whose meaning is defined outside the portable core."
    }
  },
  "additionalProperties": false
}
