{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open Prompt Format 0.2 frontmatter",
  "description": "Parsed YAML metadata for versionless OPF prompt sources.",
  "type": "object",
  "required": ["format", "id"],
  "properties": {
    "format": { "const": "opf/0.2" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "const": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced metadata whose meaning is defined outside the portable core."
    }
  },
  "additionalProperties": false
}
